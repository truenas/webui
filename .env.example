# E2E target configuration (see e2e/README.md).
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit credentials.
# In CI these come from the job's credentials, not a file.

# Which target to run against.
#   shipped — the UI baked into the appliance image, at https://<host>/ui/
#   branch  — a locally served webui build, at http://localhost:4200/
#
# The paths differ. /ui/ is where the appliance's nginx serves the UI; a local
# build defaults to / because only `build:prod` passes --base-href /ui/.
TN_PROFILE=shipped

# Credentials for an account with full admin privileges. The API client rejects
# anything less (`loginWithUserPass` requires the FullAdmin role).
TN_USERNAME=
TN_PASSWORD=

# The appliance under test — host or host:port, no scheme.
#
# Usually omitted: it defaults to whatever `yarn ui remote -i <ip>` pointed
# webui at, so configuring the dev server configures the E2E suite too. Set it
# explicitly to target a different machine, or in CI where no one runs
# `yarn ui remote`.
# TN_HOST=

# Optional. Overrides the UI base URL. Must end with "/" — without a trailing
# slash, relative navigation drops the last path segment. `shipped` derives it
# from the host; `branch` defaults to http://localhost:4200/.
# TN_UI_BASE_URL=http://localhost:4200/

# Debugging affordances, all off by default.
# TN_SLOW_MO=600           # pause N ms between browser actions; pair with --headed
# TN_VIDEO=1               # record every test at 1280x720
# TN_KEEP_TEST_DATA=1      # leave created pools/shares/users on the appliance
